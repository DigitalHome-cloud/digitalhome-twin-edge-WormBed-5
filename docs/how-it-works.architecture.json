    "views": [
      {
        "id": "plan",
        "label": "From the map to a world",
        "focus": [
          "map",
          "abox",
          "knowledge",
          "world",
          "webots"
        ],
        "note": "The habitat you map in PermTek-5 syncs here. One period's target becomes a Webots world, from a clean bed or as it stands."
      },
      {
        "id": "confirm",
        "label": "Propose, then confirm",
        "focus": [
          "chat",
          "page",
          "gateway",
          "actions"
        ],
        "note": "The page lists what the gantry could do. A job is sent only when you press Confirm; the chat can only propose."
      },
      {
        "id": "move",
        "label": "The gantry works a cell",
        "focus": [
          "actions",
          "driver",
          "webots",
          "gateway",
          "page"
        ],
        "note": "bed_actions lifts the tool, moves over the cell, sows, waters, probes or photographs. Soft limits are the bed; an e-stop holds it."
      },
      {
        "id": "back",
        "label": "A rehearsal",
        "focus": [
          "page",
          "driver",
          "knowledge",
          "map"
        ],
        "note": "Plants come up, grow or are lost; you harvest and move on. Nothing is written back: the map keeps what a person planned."
      },
      {
        "id": "replay",
        "label": "A run, replayed",
        "focus": [
          "world",
          "assets",
          "driver",
          "track",
          "film"
        ],
        "note": "The run is recorded as it goes and written as an OpenUSD stage: replay it in usdview or Blender. The films render it with the same shapes."
      }
    ]
  },
