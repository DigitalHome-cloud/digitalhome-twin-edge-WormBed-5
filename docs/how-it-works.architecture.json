    "views": [
      {
        "id": "plan",
        "label": "From the map to a world",
        "focus": [
          "map",
          "abox",
          "knowledge",
          "world",
          "webots"
        ],
        "note": "The habitat you map in PermTek-5 syncs to this PC. Its bed, cells and crops become a Webots world; nothing is drawn by hand."
      },
      {
        "id": "confirm",
        "label": "Propose, then confirm",
        "focus": [
          "chat",
          "page",
          "gateway",
          "actions"
        ],
        "note": "The page lists what the gantry could do. A job is sent only when you press Confirm; the chat can only propose."
      },
      {
        "id": "move",
        "label": "The gantry works a cell",
        "focus": [
          "actions",
          "driver",
          "webots",
          "gateway",
          "page"
        ],
        "note": "bed_actions lifts the tool, moves over the cell, sows, waters, probes or photographs. Soft limits are the bed; an e-stop holds it."
      },
      {
        "id": "back",
        "label": "Back to the map",
        "focus": [
          "page",
          "knowledge",
          "abox",
          "map"
        ],
        "note": "A sown cell is written into the habitat's copy, checked with the cloud's shapes, and the next sync shows it on the map."
      },
      {
        "id": "films",
        "label": "Webots world and Blender film",
        "focus": [
          "world",
          "webots",
          "driver",
          "assets",
          "film"
        ],
        "note": "Both read bed.json and one set of Blender shapes. Webots runs it live; the film renders it slowly and lifelike, with the box's worms."
      }
    ]
  },
