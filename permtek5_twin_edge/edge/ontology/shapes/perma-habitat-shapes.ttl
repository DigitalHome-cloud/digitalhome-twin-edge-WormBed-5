@prefix perma:   <https://permaculture.digitalhome.cloud/ontology#> .
@prefix permash: <https://permaculture.digitalhome.cloud/shapes#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# SHACL shapes for a habitat's A-Box, v0.1. Validate TOGETHER with
# tbox/perma-habitat-concepts.ttl. The cloud checks every save with them
# (ADR-0007), without the crop library: crops are checked by IRI. What SHACL
# core cannot say (a cell inside its bed) packages/core checks before saving.
# ============================================================

permash:InZoneKinds a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:ZoneKinds ] .
permash:InExposures a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:Exposures ] .
permash:InCellStatuses a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:CellStatuses ] .
permash:InPeriodKinds a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:PeriodKinds ] .
permash:InGuildTypes a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:GuildTypes ] .
permash:InRobotModels a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:RobotModels ] .
permash:InSubstrateKinds a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:SubstrateKinds ] .
permash:InSurfaceCategories a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:SurfaceCategories ] .
permash:InWaterStoreKinds a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:WaterStoreKinds ] .
permash:InWaterKinds a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:WaterKinds ] .
permash:InValveKinds a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue perma:ValveKinds ] .

permash:LibraryCrop a sh:PropertyShape ;
    sh:path perma:grows ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    sh:pattern "^https://permaculture\\.digitalhome\\.cloud/id/crop-[a-z0-9-]+$" ;
    sh:message "It grows one crop of the library (…/id/crop-…)."@en .

permash:GardenZoneShape a sh:NodeShape ;
    sh:targetClass perma:GardenZone ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "An area needs a name."@en ] ;
    sh:property [ sh:path perma:zoneKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:node permash:InZoneKinds ;
                  sh:message "An area is of one kind from perma:ZoneKinds."@en ] ;
    sh:property [ sh:path perma:exposure ; sh:node permash:InExposures ;
                  sh:message "Exposures come from perma:Exposures."@en ] ;
    sh:property [ sh:path perma:areaM2 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ;
                  sh:message "Area in m², at least 0."@en ] ;
    sh:property [ sh:path perma:microclimateOffsetC ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minInclusive -5 ; sh:maxInclusive 5 ; sh:message "The microclimate offset is -5..5 °C."@en ] .

permash:GuildShape a sh:NodeShape ;
    sh:targetClass perma:Guild ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A Perma5Guild needs a name."@en ] ;
    sh:property [ sh:path perma:inZone ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:GardenZone ;
                  sh:message "A Perma5Guild stands in one area of the site."@en ] ;
    sh:property [ sh:path perma:guildType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node permash:InGuildTypes ;
                  sh:message "A Perma5Guild is of one type from perma:GuildTypes."@en ] ;
    sh:property [ sh:path perma:robotModel ; sh:maxCount 1 ; sh:node permash:InRobotModels ;
                  sh:message "A guild's robot is one concept from perma:RobotModels."@en ] ;
    sh:property [ sh:path perma:wormsMayLeave ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

permash:GrowingBedShape a sh:NodeShape ;
    sh:targetClass perma:GrowingBed ;
    sh:property [ sh:path perma:inGuild ; sh:maxCount 1 ; sh:class perma:Guild ;
                  sh:message "A bed belongs to at most one Perma5Guild of the site."@en ] ;
    sh:property [ sh:path perma:inFarm ; sh:maxCount 1 ; sh:class perma:BedFarm ;
                  sh:message "A bed belongs to at most one farm of beds of the site."@en ] ;
    sh:property [ sh:path perma:surfaceCategory ; sh:maxCount 1 ; sh:node permash:InSurfaceCategories ;
                  sh:message "A bed's surface category is one concept from perma:SurfaceCategories."@en ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A bed needs a name."@en ] ;
    sh:property [ sh:path perma:inZone ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:GardenZone ;
                  sh:message "A bed lies in one area of the site."@en ] ;
    sh:property [ sh:path perma:lengthCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 3000 ; sh:message "A bed's length is 10..3000 cm."@en ] ;
    sh:property [ sh:path perma:widthCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 1000 ; sh:message "A bed's width is 10..1000 cm."@en ] ;
    sh:property [ sh:path perma:substrateDepthCm ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:maxInclusive 300 ; sh:message "Substrate depth is 0..300 cm."@en ] ;
    sh:property [ sh:path perma:cellSizeCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 5 ; sh:maxInclusive 100 ; sh:message "A bed's cells are 5..100 cm."@en ] ;
    sh:property [ sh:path perma:substrateKind ; sh:maxCount 1 ; sh:node permash:InSubstrateKinds ;
                  sh:message "A bed's substrate is one concept from perma:SubstrateKinds."@en ] ;
    sh:property [ sh:path perma:tankPipeCount ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:maxInclusive 20 ; sh:message "A bed has 0..20 tank pipes."@en ] ;
    sh:property [ sh:path perma:tankPipeMm ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 50 ; sh:maxInclusive 200 ; sh:message "Tank pipes are 50..200 mm across."@en ] ;
    sh:property [ sh:path perma:mulchCm ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 15 ;
                  sh:message "Mulch is 0..15 cm thick."@en ] ;
    sh:property [ sh:path perma:wormBinCm ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                  sh:lessThan perma:lengthCm ;
                  sh:message "The worm box is shorter than its bed."@en ] .

# A farm of beds (docs/adr/0027): its beds share one size; up to 50 of them, with paths of 20..200 cm.
permash:BedFarmShape a sh:NodeShape ;
    sh:targetClass perma:BedFarm ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A farm of beds needs a name."@en ] ;
    sh:property [ sh:path perma:inZone ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:GardenZone ;
                  sh:message "A farm of beds lies in one area of the site."@en ] ;
    sh:property [ sh:path perma:bedRows ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 10 ; sh:message "A farm has 1..10 rows of beds."@en ] ;
    sh:property [ sh:path perma:bedsPerRow ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 10 ; sh:message "A farm has 1..10 beds per row."@en ] ;
    sh:property [ sh:path perma:pathCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 20 ; sh:maxInclusive 200 ; sh:message "Paths between beds are 20..200 cm."@en ] ;
    sh:property [ sh:path perma:bedLengthCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 3000 ; sh:message "A bed's length is 10..3000 cm."@en ] ;
    sh:property [ sh:path perma:bedWidthCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 10 ; sh:maxInclusive 1000 ; sh:message "A bed's width is 10..1000 cm."@en ] ;
    sh:property [ sh:path perma:cellSizeCm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 5 ; sh:maxInclusive 100 ; sh:message "A bed's cells are 5..100 cm."@en ] .

# A plant set in a space's graph (a person's own, or the edge agent's draft): a name, and members with a library crop and a share.
permash:PlantSetShape a sh:NodeShape ;
    sh:targetClass perma:PlantSet ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "A plant set needs a name."@en ] ;
    sh:property [ sh:path perma:member ; sh:minCount 1 ; sh:node permash:SetMemberShape ;
                  sh:message "A plant set has at least one member."@en ] ;
    sh:property [ sh:path perma:setFor ; sh:node permash:InSurfaceCategories ;
                  sh:message "A plant set is for concepts from perma:SurfaceCategories."@en ] ;
    sh:property [ sh:path perma:draft ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
permash:SetMemberShape a sh:NodeShape ;
    sh:property [ sh:path perma:memberCrop ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:pattern "^https://permaculture\\.digitalhome\\.cloud/id/crop-[a-z0-9-]+$" ;
                  sh:message "A member is one crop of the library (…/id/crop-…)."@en ] ;
    sh:property [ sh:path perma:share ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ; sh:maxInclusive 100 ;
                  sh:message "A member's share is above 0, up to 100."@en ] .

# A bed's growing period (docs/adr/0029). That a bed's periods do not overlap, packages/core checks.
permash:GrowingPeriodShape a sh:NodeShape ;
    sh:targetClass perma:GrowingPeriod ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A period needs a name."@en ] ;
    sh:property [ sh:path perma:ofBed ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:GrowingBed ;
                  sh:message "A period belongs to one bed of the site."@en ] ;
    sh:property [ sh:path perma:fromMonth ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 12 ; sh:message "A period starts in a month 1..12."@en ] ;
    sh:property [ sh:path perma:toMonth ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 12 ; sh:message "A period ends in a month 1..12."@en ] ;
    sh:property [ sh:path perma:periodKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:node permash:InPeriodKinds ;
                  sh:message "A period's kind is one concept from perma:PeriodKinds."@en ] ;
    sh:property [ sh:path perma:setChoice ; sh:node permash:SetChoiceShape ] .
permash:SetChoiceShape a sh:NodeShape ;
    sh:property [ sh:path perma:plantSet ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A set choice names one plant set."@en ] ;
    sh:property [ sh:path perma:share ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ; sh:maxInclusive 100 ;
                  sh:message "A set's share is above 0, up to 100."@en ] .

permash:PlantingCellShape a sh:NodeShape ;
    sh:targetClass perma:PlantingCell ;
    sh:property [ sh:path perma:inBed ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:GrowingBed ;
                  sh:message "A cell belongs to one bed of the site."@en ] ;
    sh:property [ sh:path perma:row ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                  sh:message "A cell's row is a whole number from 0."@en ] ;
    sh:property [ sh:path perma:col ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                  sh:message "A cell's column is a whole number from 0."@en ] ;
    sh:property permash:LibraryCrop ;
    sh:property [ sh:path perma:cellStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:node permash:InCellStatuses ;
                  sh:message "A cell's status is one concept from perma:CellStatuses."@en ] ;
    sh:property [ sh:path perma:cellSowingDepthMm ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 150 ;
                  sh:message "Sowing depth is 0..150 mm."@en ] ;
    sh:property [ sh:path perma:cellSeedsPerPoint ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 20 ;
                  sh:message "Seeds per point is 1..20."@en ] ;
    sh:property [ sh:path perma:sownOn ; sh:maxCount 1 ; sh:datatype xsd:date ;
                  sh:message "Sown on is a date (YYYY-MM-DD)."@en ] ;
    sh:property [ sh:path perma:inPeriod ; sh:maxCount 1 ; sh:class perma:GrowingPeriod ;
                  sh:message "A cell is the target of at most one period of the site."@en ] .

permash:GardenPlantShape a sh:NodeShape ;
    sh:targetClass perma:GardenPlant ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A garden plant needs a name."@en ] ;
    sh:property [ sh:path perma:inZone ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:GardenZone ;
                  sh:message "A garden plant stands in one area of the site."@en ] ;
    sh:property permash:LibraryCrop ;
    sh:property [ sh:path perma:plantedYear ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1800 ; sh:maxInclusive 2200 ; sh:message "Planted in: a year."@en ] ;
    sh:property [ sh:path perma:rootstock ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path perma:xM ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ;
                  sh:message "x is metres from the area's edge, at least 0."@en ] ;
    sh:property [ sh:path perma:yM ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ;
                  sh:message "y is metres from the area's edge, at least 0."@en ] .

# ------------------------------------------------------------ water (v0.2, docs/adr/0025)

permash:RainCatchmentShape a sh:NodeShape ;
    sh:targetClass perma:RainCatchment ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A rain catchment needs a name."@en ] ;
    sh:property [ sh:path perma:inGuild ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:Guild ;
                  sh:message "A rain catchment belongs to one Perma5Guild."@en ] ;
    sh:property [ sh:path perma:inZone ; sh:maxCount 1 ; sh:class perma:GardenZone ] ;
    sh:property [ sh:path perma:catchmentM2 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                  sh:minExclusive 0 ; sh:maxInclusive 1000 ; sh:message "A catchment is over 0 and up to 1000 m²."@en ] ;
    sh:property [ sh:path perma:runoffShare ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ;
                  sh:message "The runoff share is 0..1."@en ] ;
    sh:property [ sh:path perma:drainsTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:WaterStore ;
                  sh:message "A rain catchment fills one water store."@en ] .

permash:WaterStoreShape a sh:NodeShape ;
    sh:targetClass perma:WaterStore ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A water store needs a name."@en ] ;
    sh:property [ sh:path perma:inGuild ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:Guild ;
                  sh:message "A water store belongs to one Perma5Guild."@en ] ;
    sh:property [ sh:path perma:inZone ; sh:maxCount 1 ; sh:class perma:GardenZone ;
                  sh:message "A water store stands in at most one area (its guild's when none is said)."@en ] ;
    sh:property [ sh:path perma:storeKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:node permash:InWaterStoreKinds ;
                  sh:message "A water store is of one kind from perma:WaterStoreKinds."@en ] ;
    sh:property [ sh:path perma:capacityL ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 100000 ;
                  sh:message "A store holds 0..100000 l."@en ] ;
    sh:property [ sh:path perma:holds ; sh:minCount 1 ; sh:node permash:InWaterKinds ;
                  sh:message "A water store says what it holds: concepts from perma:WaterKinds."@en ] ;
    sh:property [ sh:path perma:overflowTo ; sh:maxCount 1 ; sh:class perma:WaterStore ] .

# Worm liquid never into a store kept for clean water: either the valve's source holds no worm liquid, or
# its target may hold it. (SHACL Core, so the cloud's validator and an edge's check the same.)
permash:WormLiquidKeepsOut a sh:NodeShape ;
    sh:not [ sh:property [ sh:path ( perma:flowFrom perma:holds ) ; sh:hasValue perma:WormLiquid ] ] .
permash:TakesWormLiquid a sh:NodeShape ;
    sh:property [ sh:path ( perma:flowTo perma:holds ) ; sh:hasValue perma:WormLiquid ] .

permash:ValveShape a sh:NodeShape ;
    sh:targetClass perma:Valve ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A valve needs a name."@en ] ;
    sh:property [ sh:path perma:inGuild ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:Guild ;
                  sh:message "A valve belongs to one Perma5Guild."@en ] ;
    sh:property [ sh:path perma:flowFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:WaterStore ;
                  sh:message "A valve takes from one water store."@en ] ;
    sh:property [ sh:path perma:flowTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class perma:WaterStore ;
                  sh:message "A valve gives to one water store."@en ] ;
    sh:property [ sh:path perma:valveKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:node permash:InValveKinds ;
                  sh:message "A valve is a manual tap or an edge valve (perma:ValveKinds)."@en ] ;
    sh:or ( permash:WormLiquidKeepsOut permash:TakesWormLiquid ) ;
    sh:message "Worm liquid never flows into a store kept for clean water."@en .
