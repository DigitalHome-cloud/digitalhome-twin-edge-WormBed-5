@prefix perma: <https://permaculture.digitalhome.cloud/ontology#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# ============================================================
# perma-core, habitat concept schemes, v0.1. New kinds are data.
# ============================================================

perma:ZoneKinds a skos:ConceptScheme ;
    skos:prefLabel "Kinds of area"@en , "Arten von Bereichen"@de , "Types de zone"@fr ;
    skos:hasTopConcept perma:RoofZone , perma:GroundZone , perma:BalconyZone , perma:GreenhouseZone .
perma:RoofZone a skos:Concept ; skos:inScheme perma:ZoneKinds ; skos:topConceptOf perma:ZoneKinds ;
    skos:prefLabel "Roof"@en , "Dach"@de , "Toit"@fr .
perma:GroundZone a skos:Concept ; skos:inScheme perma:ZoneKinds ; skos:topConceptOf perma:ZoneKinds ;
    skos:prefLabel "Garden ground"@en , "Gartenboden"@de , "Pleine terre"@fr .
perma:BalconyZone a skos:Concept ; skos:inScheme perma:ZoneKinds ; skos:topConceptOf perma:ZoneKinds ;
    skos:prefLabel "Balcony or terrace"@en , "Balkon oder Terrasse"@de , "Balcon ou terrasse"@fr .
perma:GreenhouseZone a skos:Concept ; skos:inScheme perma:ZoneKinds ; skos:topConceptOf perma:ZoneKinds ;
    skos:prefLabel "Greenhouse"@en , "Gewächshaus"@de , "Serre"@fr .

perma:Exposures a skos:ConceptScheme ;
    skos:prefLabel "Exposure"@en , "Lage"@de , "Exposition"@fr ;
    skos:hasTopConcept perma:FullSun , perma:HalfShade , perma:Shade , perma:Windy .
perma:FullSun a skos:Concept ; skos:inScheme perma:Exposures ; skos:topConceptOf perma:Exposures ;
    skos:prefLabel "Full sun"@en , "Volle Sonne"@de , "Plein soleil"@fr .
perma:HalfShade a skos:Concept ; skos:inScheme perma:Exposures ; skos:topConceptOf perma:Exposures ;
    skos:prefLabel "Half shade"@en , "Halbschatten"@de , "Mi-ombre"@fr .
perma:Shade a skos:Concept ; skos:inScheme perma:Exposures ; skos:topConceptOf perma:Exposures ;
    skos:prefLabel "Shade"@en , "Schatten"@de , "Ombre"@fr .
perma:Windy a skos:Concept ; skos:inScheme perma:Exposures ; skos:topConceptOf perma:Exposures ;
    skos:prefLabel "Windy"@en , "Windig"@de , "Venté"@fr .

perma:CellStatuses a skos:ConceptScheme ;
    skos:prefLabel "Cell status"@en , "Zellstand"@de , "État de la case"@fr ;
    skos:hasTopConcept perma:CellPlanned , perma:CellSown , perma:CellGrowing , perma:CellHarvested , perma:CellLost .
perma:CellPlanned a skos:Concept ; skos:inScheme perma:CellStatuses ; skos:topConceptOf perma:CellStatuses ;
    skos:prefLabel "Planned"@en , "Geplant"@de , "Prévu"@fr .
perma:CellSown a skos:Concept ; skos:inScheme perma:CellStatuses ; skos:topConceptOf perma:CellStatuses ;
    skos:prefLabel "Sown or planted"@en , "Gesät oder gepflanzt"@de , "Semé ou planté"@fr .
perma:CellGrowing a skos:Concept ; skos:inScheme perma:CellStatuses ; skos:topConceptOf perma:CellStatuses ;
    skos:prefLabel "Growing"@en , "Wächst"@de , "En croissance"@fr .
perma:CellHarvested a skos:Concept ; skos:inScheme perma:CellStatuses ; skos:topConceptOf perma:CellStatuses ;
    skos:prefLabel "Harvested"@en , "Geerntet"@de , "Récolté"@fr .
perma:CellLost a skos:Concept ; skos:inScheme perma:CellStatuses ; skos:topConceptOf perma:CellStatuses ;
    skos:prefLabel "Lost"@en , "Ausgefallen"@de , "Perdu"@fr ;
    skos:definition "Did not come up, froze or dried out: the cell is free to sow again (docs/adr/0029)."@en .

perma:PeriodKinds a skos:ConceptScheme ;
    skos:prefLabel "Kind of period"@en , "Art des Abschnitts"@de , "Type de période"@fr ;
    skos:hasTopConcept perma:GrowingKind , perma:RestKind .
perma:GrowingKind a skos:Concept ; skos:inScheme perma:PeriodKinds ; skos:topConceptOf perma:PeriodKinds ;
    skos:prefLabel "Growing"@en , "Anbau"@de , "Culture"@fr ;
    skos:definition "From sowing to harvest: the bed is planted with the period's plant sets."@en .
perma:RestKind a skos:Concept ; skos:inScheme perma:PeriodKinds ; skos:topConceptOf perma:PeriodKinds ;
    skos:prefLabel "Rest"@en , "Ruhe"@de , "Repos"@fr ;
    skos:definition "Winter or maintenance: nothing is sown but a cover crop; the worm box goes on in its winter care."@en .

perma:SurfaceCategories a skos:ConceptScheme ;
    skos:prefLabel "Surface categories"@en , "Flächenarten"@de , "Catégories de surface"@fr ;
    skos:hasTopConcept perma:RectangleBedSurface , perma:BedFarmSurface .
perma:RectangleBedSurface a skos:Concept ; skos:inScheme perma:SurfaceCategories ; skos:topConceptOf perma:SurfaceCategories ;
    skos:prefLabel "Rectangle bed"@en , "Rechteckbeet"@de , "Planche rectangulaire"@fr ;
    skos:definition "One rectangular bed of square cells, up to 30 m long and 10 m wide; planted by cells (docs/adr/0027)."@en .
perma:BedFarmSurface a skos:Concept ; skos:inScheme perma:SurfaceCategories ; skos:topConceptOf perma:SurfaceCategories ;
    skos:prefLabel "Farm of beds"@en , "Beetfeld"@de , "Ensemble de planches"@fr ;
    skos:definition "Rectangle beds of one size in rows, with paths between them, up to 50 beds; plant sets are shared out over the beds."@en .
# Greenhouses and food forests come once beds and farms of beds are right (docs/adr/0028).

perma:SubstrateKinds a skos:ConceptScheme ;
    skos:prefLabel "Substrates"@en , "Substrate"@de , "Substrats"@fr ;
    skos:hasTopConcept perma:LightweightRoofSubstrate , perma:GardenSoil , perma:PottingCompost .
perma:LightweightRoofSubstrate a skos:Concept ; skos:inScheme perma:SubstrateKinds ; skos:topConceptOf perma:SubstrateKinds ;
    skos:prefLabel "Lightweight roof substrate"@en , "Leichtes Dachsubstrat"@de , "Substrat léger pour toiture"@fr ;
    skos:definition "A mineral mix made for green roofs (expanded clay or shale, pumice, some compost): lighter when wet than soil."@en .
perma:GardenSoil a skos:Concept ; skos:inScheme perma:SubstrateKinds ; skos:topConceptOf perma:SubstrateKinds ;
    skos:prefLabel "Garden soil"@en , "Gartenerde"@de , "Terre de jardin"@fr ;
    skos:definition "Topsoil, with or without compost: the heaviest choice when wet."@en .
perma:PottingCompost a skos:Concept ; skos:inScheme perma:SubstrateKinds ; skos:topConceptOf perma:SubstrateKinds ;
    skos:prefLabel "Potting compost"@en , "Blumenerde"@de , "Terreau"@fr ;
    skos:definition "Peat-free potting mix: light, but it settles and has to be topped up."@en .

perma:GuildTypes a skos:ConceptScheme ;
    skos:prefLabel "Guild types"@en , "Gildentypen"@de , "Types de guilde"@fr ;
    skos:hasTopConcept perma:WormBed5 .
perma:WormBed5 a skos:Concept ; skos:inScheme perma:GuildTypes ; skos:topConceptOf perma:GuildTypes ;
    skos:prefLabel "WormBed5"@en , "WormBed5"@de , "WormBed5"@fr ;
    skos:definition "A flat growing bed with a worm compost box at one end, whose liquid reaches the plants from below, worked by a gantry robot (docs/specs/roofbed-system.md)."@en .

perma:RobotModels a skos:ConceptScheme ;
    skos:prefLabel "Robots"@en , "Roboter"@de , "Robots"@fr ;
    skos:hasTopConcept perma:Gantry5Gen1 .
perma:Gantry5Gen1 a skos:Concept ; skos:inScheme perma:RobotModels ; skos:topConceptOf perma:RobotModels ;
    skos:prefLabel "Gantry5-gen1"@en , "Gantry5-gen1"@de , "Gantry5-gen1"@fr ;
    skos:definition "Gantry5, first generation: three axes over a bed, with a seeder, a watering nozzle, a soil probe, a camera and a scoop for the worm box (docs/specs/roofbed-robot.md)."@en .

# ------------------------------------------------------------ water (v0.2, docs/adr/0025)

perma:WaterStoreKinds a skos:ConceptScheme ;
    skos:prefLabel "Water stores"@en , "Wasserspeicher"@de , "Réserves d'eau"@fr ;
    skos:hasTopConcept perma:RainBarrel , perma:TankPipes , perma:WormBoxSump , perma:WormBoxBin , perma:GardenTank .
perma:RainBarrel a skos:Concept ; skos:inScheme perma:WaterStoreKinds ; skos:topConceptOf perma:WaterStoreKinds ;
    skos:prefLabel "Rain barrel"@en , "Regentonne"@de , "Récupérateur d'eau de pluie"@fr ;
    skos:definition "Collects rain from a catchment; a tap at its foot lets it on."@en .
perma:TankPipes a skos:Concept ; skos:inScheme perma:WaterStoreKinds ; skos:topConceptOf perma:WaterStoreKinds ;
    skos:prefLabel "Tank pipes"@en , "Tankrohre"@de , "Tuyaux-réservoir"@fr ;
    skos:definition "The drain pipes under a wicking bed's substrate: the soil draws their water up from below."@en .
perma:WormBoxSump a skos:Concept ; skos:inScheme perma:WaterStoreKinds ; skos:topConceptOf perma:WaterStoreKinds ;
    skos:prefLabel "Worm box sump"@en , "Sumpf der Wurmkiste"@de , "Puisard du bac à vers"@fr ;
    skos:definition "The worm box's lower bin: it catches the liquid that drips from the worms' bin."@en .
perma:WormBoxBin a skos:Concept ; skos:inScheme perma:WaterStoreKinds ; skos:topConceptOf perma:WaterStoreKinds ;
    skos:prefLabel "Worm box bin"@en , "Arbeitskiste der Wurmkiste"@de , "Bac de travail du bac à vers"@fr ;
    skos:definition "The worm box's working bin, as a place water goes to: a mist line under its lid waters the bedding with clean water, the box closed. It stores nothing; its moisture probe says when it needs some."@en .
perma:GardenTank a skos:Concept ; skos:inScheme perma:WaterStoreKinds ; skos:topConceptOf perma:WaterStoreKinds ;
    skos:prefLabel "Garden tank"@en , "Gartentank"@de , "Cuve de jardin"@fr ;
    skos:definition "A tank elsewhere on the site, e.g. in the garden by the fruit trees: it takes what the guild's own bed does not need."@en .

perma:WaterKinds a skos:ConceptScheme ;
    skos:prefLabel "Kinds of water"@en , "Wasserarten"@de , "Types d'eau"@fr ;
    skos:hasTopConcept perma:CleanWater , perma:WormLiquid .
perma:CleanWater a skos:Concept ; skos:inScheme perma:WaterKinds ; skos:topConceptOf perma:WaterKinds ;
    skos:prefLabel "Clean water"@en , "Sauberes Wasser"@de , "Eau propre"@fr ;
    skos:definition "Rain or tap water: it may go on leaves and seeds."@en .
perma:WormLiquid a skos:Concept ; skos:inScheme perma:WaterKinds ; skos:topConceptOf perma:WaterKinds ;
    skos:prefLabel "Worm liquid"@en , "Wurmflüssigkeit"@de , "Liquide du lombricomposteur"@fr ;
    skos:definition "Drainage from fresh worm compost: rich, but never on leaves of anything eaten raw. Given below the surface only."@en .

perma:ValveKinds a skos:ConceptScheme ;
    skos:prefLabel "Valves"@en , "Ventile"@de , "Vannes"@fr ;
    skos:hasTopConcept perma:ManualTap , perma:EdgeValve .
perma:ManualTap a skos:Concept ; skos:inScheme perma:ValveKinds ; skos:topConceptOf perma:ValveKinds ;
    skos:prefLabel "Manual tap"@en , "Handhahn"@de , "Robinet manuel"@fr ;
    skos:definition "A person opens and closes it; the edge proposes when."@en .
perma:EdgeValve a skos:Concept ; skos:inScheme perma:ValveKinds ; skos:topConceptOf perma:ValveKinds ;
    skos:prefLabel "Edge valve"@en , "Edge-Ventil"@de , "Vanne pilotée"@fr ;
    skos:definition "A motor or solenoid valve the guild's edge opens, after a person confirmed the proposal."@en .
