@prefix perma: <https://permaculture.digitalhome.cloud/ontology#> .
@prefix crop:  <https://permaculture.digitalhome.cloud/id/> .
@prefix id:    <https://permtek-5.digitalhome.cloud/id/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# CityDemo: an INVENTED city habitat, like everything in this public repository.
# A small flat roof with one wicking bed (3 m x 1.2 m, 10 cm cells: 12 rows, 30 columns; eight tank
# pipes under 15 cm of lightweight substrate; a worm box on its last 40 cm)
# and a small back garden with three fruit trees. Positions are metres inside
# each zone, never geographic.

id:zone-z-cityroof a perma:GardenZone ; rdfs:label "Flat roof" ;
    perma:zoneKind perma:RoofZone ; perma:exposure perma:FullSun , perma:Windy ;
    perma:areaM2 12.0 ; perma:microclimateOffsetC 1.0 .

id:zone-z-citygarden a perma:GardenZone ; rdfs:label "Back garden" ;
    perma:zoneKind perma:GroundZone ; perma:exposure perma:HalfShade ;
    perma:areaM2 60.0 ; perma:microclimateOffsetC 0.0 .

id:bed-b-citybed a perma:GrowingBed ; rdfs:label "Roof bed" ; perma:inZone id:zone-z-cityroof ;
    perma:lengthCm 300 ; perma:widthCm 120 ; perma:substrateDepthCm 15 ; perma:cellSizeCm 10 ;
    perma:substrateKind perma:LightweightRoofSubstrate ; perma:tankPipeCount 8 ; perma:tankPipeMm 110 ; perma:wormBinCm 40 .

id:cell-c001 a perma:PlantingCell ; perma:inBed id:bed-b-citybed ; perma:row 1 ; perma:col 1 ;
    perma:grows crop:crop-lettuce ; perma:cellStatus perma:CellGrowing ; perma:sownOn "2026-04-18"^^xsd:date .
id:cell-c002 a perma:PlantingCell ; perma:inBed id:bed-b-citybed ; perma:row 1 ; perma:col 4 ;
    perma:grows crop:crop-lettuce ; perma:cellStatus perma:CellGrowing ; perma:sownOn "2026-04-18"^^xsd:date .
id:cell-c003 a perma:PlantingCell ; perma:inBed id:bed-b-citybed ; perma:row 1 ; perma:col 7 ;
    perma:grows crop:crop-lettuce ; perma:cellStatus perma:CellGrowing ; perma:sownOn "2026-04-18"^^xsd:date .
