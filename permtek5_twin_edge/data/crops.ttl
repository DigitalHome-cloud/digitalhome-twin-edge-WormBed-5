@prefix perma: <https://permaculture.digitalhome.cloud/ontology#> .
@prefix id:    <https://permaculture.digitalhome.cloud/id/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dwc:   <http://rs.tdwg.org/dwc/terms/> .

# The shared crop library, v0.3: the crops of the recipes, salad crops for a roof bed, fruit trees, and what each
# herbaceous crop takes from the bed and gives to it (at the end of the file). The same for
# every project; when and where they grow is each site's calendar.
# Names: English, French, German and Latin (rdfs:label @en @fr @de @la). GBIF links are in
# crops-gbif.ttl (generated by tools/gbif_link.py).
# keeps: the ways each part can be kept and for how many months after the harvest (approximate).

id:crop-courgette a perma:Crop ;
    rdfs:label "Courgette"@en , "Zucchini"@de , "Courgette"@fr , "Cucurbita pepo"@la ;
    rdfs:comment "The courgette group of the species; pumpkins and pâtissons are the same species and cross with it."@en ;
    dwc:scientificName "Cucurbita pepo" ;
    perma:sowingDepthMm 25 ; perma:seedsPerPoint 2 ; perma:germinationDays 7 ; perma:waterMmPerWeek 30.0 ;
    perma:sowMinTempC 14.0 ; perma:plantOutMinNightC 10.0 ; perma:frostTender true ; perma:daysToHarvest 60 ; perma:spacingCm 80 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Cucurbita pepo: other courgettes, pumpkins, pâtissons, ornamental gourds" ;
        perma:isolationM 800.0 ; perma:seedViabilityYears 6 ; perma:selfSows false ;
        rdfs:comment "Or hand-pollinate a female flower and close it. Seed from a fruit left to mature on the plant about 8 weeks past eating size."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] ] .

id:crop-onion a perma:Crop ;
    rdfs:label "Onion"@en , "Zwiebel"@de , "Oignon"@fr , "Allium cepa"@la ;
    dwc:scientificName "Allium cepa" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 1 ; perma:germinationDays 12 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 7.0 ; perma:frostTender false ; perma:daysToHarvest 120 ; perma:spacingCm 10 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Biennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Allium cepa, including shallots" ;
        perma:isolationM 1000.0 ; perma:seedViabilityYears 2 ; perma:selfSows false ;
        rdfs:comment "Keep the best bulbs over winter, replant them in spring; seed heads ripen in summer of the second year. Seed is short-lived: renew every year or two."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Bulb ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 6 ] ] .

id:crop-sweet-pepper a perma:Crop ;
    rdfs:label "Sweet pepper"@en , "Paprika"@de , "Poivron"@fr , "Capsicum annuum"@la ;
    rdfs:comment "The sweet (non-pungent) group of the species; chillies are the same species."@en ;
    dwc:scientificName "Capsicum annuum" ;
    perma:sowingDepthMm 5 ; perma:seedsPerPoint 2 ; perma:germinationDays 12 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 18.0 ; perma:plantOutMinNightC 12.0 ; perma:frostTender true ; perma:daysToHarvest 150 ; perma:spacingCm 40 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:SelfPollinating ;
        perma:crossesWith "every Capsicum annuum, chillies included (insects cross some flowers)" ;
        perma:isolationM 50.0 ; perma:seedViabilityYears 3 ; perma:selfSows false ;
        rdfs:comment "Seed from fully ripe (coloured) fruit; bag a few flowers if chillies grow nearby."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-dill a perma:Crop ;
    rdfs:label "Dill"@en , "Dill"@de , "Aneth"@fr , "Anethum graveolens"@la ;
    dwc:scientificName "Anethum graveolens" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 3 ; perma:germinationDays 14 ; perma:waterMmPerWeek 15.0 ;
    perma:sowMinTempC 10.0 ; perma:boltAboveC 27.0 ; perma:frostTender false ; perma:daysToHarvest 50 ; perma:spacingCm 20 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other dill varieties" ;
        perma:isolationM 800.0 ; perma:seedViabilityYears 3 ; perma:selfSows true ;
        rdfs:comment "Let a few plants flower and dry on the stem; the same seed is the spice. Self-sows readily."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] ] ,
                 [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-white-mustard a perma:Crop ;
    rdfs:label "White mustard"@en , "Weißer Senf"@de , "Moutarde blanche"@fr , "Sinapis alba"@la ;
    rdfs:comment "Yellow mustard seed (graines de moutarde jaune) for pickles."@en ;
    dwc:scientificName "Sinapis alba" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 3 ; perma:germinationDays 5 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 5.0 ; perma:frostTender false ; perma:daysToHarvest 90 ; perma:spacingCm 10 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Sinapis alba" ;
        perma:isolationM 800.0 ; perma:seedViabilityYears 4 ; perma:selfSows true ;
        rdfs:comment "The seed harvest for the kitchen is also the seed for next year: keep some back."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-black-pepper a perma:Crop ;
    rdfs:label "Black pepper"@en , "Schwarzer Pfeffer"@de , "Poivre noir"@fr , "Piper nigrum"@la ;
    rdfs:comment "A tropical vine: in the library so recipes can name it, but no temperate site has a calendar for it."@en ;
    dwc:scientificName "Piper nigrum" ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 24 ] ] .

# ------------------------------------------------------------ added 2026-10-09: the second set of recipes

id:crop-tomato a perma:Crop ;
    rdfs:label "Tomato"@en , "Tomate"@de , "Tomate"@fr , "Solanum lycopersicum"@la ;
    dwc:scientificName "Solanum lycopersicum" ;
    perma:sowingDepthMm 5 ; perma:seedsPerPoint 2 ; perma:germinationDays 8 ; perma:waterMmPerWeek 30.0 ;
    perma:sowMinTempC 16.0 ; perma:plantOutMinNightC 10.0 ; perma:frostTender true ; perma:daysToHarvest 120 ; perma:spacingCm 50 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Annual ;
        perma:pollination perma:SelfPollinating ;
        perma:crossesWith "other tomatoes, rarely (potato-leaf and old varieties more)" ;
        perma:isolationM 3.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Seed from fully ripe fruit of open-pollinated varieties (not F1); ferment the pulp a few days, rinse, dry."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-aubergine a perma:Crop ;
    rdfs:label "Aubergine"@en , "Aubergine"@de , "Aubergine"@fr , "Solanum melongena"@la ;
    dwc:scientificName "Solanum melongena" ;
    perma:sowingDepthMm 5 ; perma:seedsPerPoint 2 ; perma:germinationDays 12 ; perma:waterMmPerWeek 30.0 ;
    perma:sowMinTempC 20.0 ; perma:plantOutMinNightC 13.0 ; perma:frostTender true ; perma:daysToHarvest 150 ; perma:spacingCm 50 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Annual ;
        perma:pollination perma:SelfPollinating ;
        perma:crossesWith "other aubergines (insects cross some flowers)" ;
        perma:isolationM 15.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Leave a fruit on the plant until it turns dull yellow-brown; scrape out the seed."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] ] .

id:crop-garlic a perma:Crop ;
    rdfs:label "Garlic"@en , "Knoblauch"@de , "Ail"@fr , "Allium sativum"@la ;
    dwc:scientificName "Allium sativum" ;
    perma:sowingDepthMm 40 ; perma:seedsPerPoint 1 ; perma:germinationDays 14 ; perma:waterMmPerWeek 15.0 ;
    perma:sowMinTempC 5.0 ; perma:frostTender false ; perma:daysToHarvest 240 ; perma:spacingCm 12 ;
    perma:seedSaving [ perma:propagation perma:FromCloves ;
        perma:lifeCycle perma:Perennial ;
        perma:selfSows false ;
        rdfs:comment "Grown as an annual: keep the biggest, healthiest bulbs and replant their outer cloves in autumn."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Bulb ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 8 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-basil a perma:Crop ;
    rdfs:label "Basil"@en , "Basilikum"@de , "Basilic"@fr , "Ocimum basilicum"@la ;
    dwc:scientificName "Ocimum basilicum" ;
    perma:sowingDepthMm 3 ; perma:seedsPerPoint 3 ; perma:germinationDays 8 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 16.0 ; perma:plantOutMinNightC 12.0 ; perma:frostTender true ; perma:daysToHarvest 70 ; perma:spacingCm 20 ;
    perma:seedSaving [ perma:propagation perma:FromSeed , perma:FromCuttings ;
        perma:lifeCycle perma:Annual ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other basils (Ocimum basilicum varieties)" ;
        perma:isolationM 50.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Let a few plants flower; cut the dry flower stems and rub out the seed."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-thyme a perma:Crop ;
    rdfs:label "Thyme"@en , "Thymian"@de , "Thym"@fr , "Thymus vulgaris"@la ;
    rdfs:comment "An evergreen perennial: leaves can be picked all year, best for drying just before flowering."@en ;
    dwc:scientificName "Thymus vulgaris" ;
    perma:sowingDepthMm 1 ; perma:seedsPerPoint 4 ; perma:germinationDays 14 ; perma:waterMmPerWeek 10.0 ;
    perma:sowMinTempC 13.0 ; perma:frostTender false ; perma:daysToHarvest 120 ; perma:spacingCm 25 ;
    perma:seedSaving [ perma:propagation perma:FromCuttings , perma:ByDivision , perma:FromSeed ;
        perma:lifeCycle perma:Perennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Thymus vulgaris" ;
        perma:seedViabilityYears 3 ;
        perma:selfSows false ;
        rdfs:comment "Easiest kept by cuttings or division of a good plant; renew every 4-5 years when it gets woody."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-rosemary a perma:Crop ;
    rdfs:label "Rosemary"@en , "Rosmarin"@de , "Romarin"@fr , "Salvia rosmarinus"@la ;
    rdfs:comment "Formerly Rosmarinus officinalis. Evergreen: leaves all year."@en ;
    dwc:scientificName "Salvia rosmarinus" ;
    perma:sowingDepthMm 2 ; perma:seedsPerPoint 3 ; perma:germinationDays 21 ; perma:waterMmPerWeek 10.0 ;
    perma:sowMinTempC 15.0 ; perma:frostTender false ; perma:daysToHarvest 365 ; perma:spacingCm 60 ;
    perma:seedSaving [ perma:propagation perma:FromCuttings ;
        perma:lifeCycle perma:Perennial ;
        perma:selfSows false ;
        rdfs:comment "Take cuttings of non-flowering shoots in late summer."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-bay-laurel a perma:Crop ;
    rdfs:label "Bay laurel"@en , "Echter Lorbeer"@de , "Laurier-sauce"@fr , "Laurus nobilis"@la ;
    rdfs:comment "Evergreen shrub or small tree: leaves all year."@en ;
    dwc:scientificName "Laurus nobilis" ;
    perma:seedSaving [ perma:propagation perma:FromCuttings ;
        perma:lifeCycle perma:Perennial ;
        perma:selfSows false ;
        rdfs:comment "Semi-ripe cuttings in summer, or suckers from the base."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-white-cabbage a perma:Crop ;
    rdfs:label "White cabbage"@en , "Weißkohl"@de , "Chou blanc"@fr , "Brassica oleracea"@la ;
    rdfs:comment "The white headed cabbage group (capitata) of the species; kale, broccoli and cauliflower are the same species and cross with it."@en ;
    dwc:scientificName "Brassica oleracea" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 2 ; perma:germinationDays 7 ; perma:waterMmPerWeek 30.0 ;
    perma:sowMinTempC 7.0 ; perma:frostTender false ; perma:daysToHarvest 120 ; perma:spacingCm 50 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Biennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Brassica oleracea: other cabbages, kale, broccoli, cauliflower, kohlrabi" ;
        perma:isolationM 800.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Keep the best heads over winter, replant in spring; seed pods ripen in summer of the second year."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 4 ] , [ perma:method perma:Fermented ; perma:storageMonths 6 ] ] .

id:crop-caraway a perma:Crop ;
    rdfs:label "Caraway"@en , "Kümmel"@de , "Carvi"@fr , "Carum carvi"@la ;
    dwc:scientificName "Carum carvi" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 3 ; perma:germinationDays 14 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 8.0 ; perma:frostTender false ; perma:daysToHarvest 400 ; perma:spacingCm 20 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Biennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other caraway" ;
        perma:isolationM 800.0 ;
        perma:seedViabilityYears 2 ;
        perma:selfSows true ;
        rdfs:comment "Flowers in its second year; the seed for the kitchen is the seed for sowing."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-apple a perma:Crop ;
    rdfs:label "Apple"@en , "Apfel"@de , "Pommier (pomme)"@fr , "Malus domestica"@la ;
    dwc:scientificName "Malus domestica" ;
    perma:growthForm perma:Tree ;
    perma:typicalWindow [ perma:activity perma:Flowering ; perma:fromMonth 4 ; perma:toMonth 5 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:Harvest ; perma:part perma:Fruit ; perma:fromMonth 8 ; perma:toMonth 10 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:WinterPrune ; perma:fromMonth 12 ; perma:toMonth 2 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:SummerPrune ; perma:fromMonth 7 ; perma:toMonth 8 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ;
    perma:seedSaving [ perma:propagation perma:ByGrafting ;
        perma:lifeCycle perma:Perennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other apple and crab apple varieties (needed: most apples need a pollinator variety nearby)" ;
        perma:selfSows false ;
        rdfs:comment "Apples do not come true from seed: keep a variety by grafting scions onto a rootstock in late winter."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 5 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-walnut a perma:Crop ;
    rdfs:label "Walnut"@en , "Walnuss"@de , "Noyer (noix)"@fr , "Juglans regia"@la ;
    rdfs:comment "The green fruit (late June) is for vin de noix; the ripe nut (autumn) is the kernel, stored dry."@en ;
    dwc:scientificName "Juglans regia" ;
    perma:growthForm perma:Tree ;
    perma:typicalWindow [ perma:activity perma:Flowering ; perma:fromMonth 4 ; perma:toMonth 5 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:Harvest ; perma:part perma:Seed ; perma:fromMonth 9 ; perma:toMonth 10 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:SummerPrune ; perma:fromMonth 8 ; perma:toMonth 9 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ;
    perma:seedSaving [ perma:propagation perma:ByGrafting , perma:FromSeed ;
        perma:lifeCycle perma:Perennial ;
        perma:pollination perma:WindPollinated ;
        perma:crossesWith "other walnuts" ;
        perma:seedViabilityYears 1 ;
        perma:selfSows false ;
        rdfs:comment "Named varieties (Franquette) are grafted; seedlings vary. Nuts for sowing must not dry out."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Macerated ; perma:storageMonths 36 ] ] ,
                 [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

# ------------------------------------------------------------ salad and roof-bed crops (v0.2)

id:crop-lettuce a perma:Crop ;
    rdfs:label "Lettuce"@en , "Salat"@de , "Laitue"@fr , "Lactuca sativa"@la ;
    rdfs:comment "Sown little and often for a steady supply; bolts in heat."@en ;
    dwc:scientificName "Lactuca sativa" ;
    perma:sowingDepthMm 5 ; perma:seedsPerPoint 3 ; perma:germinationDays 7 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 5.0 ; perma:boltAboveC 25.0 ; perma:frostTender false ; perma:daysToHarvest 55 ; perma:spacingCm 25 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:SelfPollinating ;
        perma:crossesWith "other lettuces, rarely" ; perma:isolationM 3.0 ; perma:seedViabilityYears 4 ; perma:selfSows false ;
        rdfs:comment "Let the best plant bolt; cut the fluffy heads when most seeds are ripe."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] ] .

id:crop-rocket a perma:Crop ;
    rdfs:label "Rocket"@en , "Rucola"@de , "Roquette"@fr , "Eruca vesicaria"@la ;
    rdfs:comment "Salad rocket; quick, and runs to seed fast in summer."@en ;
    dwc:scientificName "Eruca vesicaria" ;
    perma:sowingDepthMm 5 ; perma:seedsPerPoint 3 ; perma:germinationDays 6 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 5.0 ; perma:boltAboveC 24.0 ; perma:frostTender false ; perma:daysToHarvest 35 ; perma:spacingCm 10 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Eruca vesicaria" ; perma:isolationM 200.0 ; perma:seedViabilityYears 4 ; perma:selfSows true ;
        rdfs:comment "Seed pods ripen weeks after flowering; it often sows itself."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] ] .

id:crop-radish a perma:Crop ;
    rdfs:label "Radish"@en , "Radieschen"@de , "Radis"@fr , "Raphanus sativus"@la ;
    rdfs:comment "Small summer radish; ready in a month."@en ;
    dwc:scientificName "Raphanus sativus" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 2 ; perma:germinationDays 5 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 5.0 ; perma:boltAboveC 24.0 ; perma:frostTender false ; perma:daysToHarvest 30 ; perma:spacingCm 5 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Raphanus sativus, including winter radish and wild radish" ; perma:isolationM 800.0 ; perma:seedViabilityYears 5 ; perma:selfSows false ;
        rdfs:comment "Leave a few roots to flower; the green pods are edible too."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Root ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] ] .

id:crop-spinach a perma:Crop ;
    rdfs:label "Spinach"@en , "Spinat"@de , "Épinard"@fr , "Spinacia oleracea"@la ;
    rdfs:comment "Spring and autumn crop; bolts in long warm days."@en ;
    dwc:scientificName "Spinacia oleracea" ;
    perma:sowingDepthMm 20 ; perma:seedsPerPoint 2 ; perma:germinationDays 10 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 4.0 ; perma:boltAboveC 22.0 ; perma:frostTender false ; perma:daysToHarvest 45 ; perma:spacingCm 10 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:WindPollinated ;
        perma:crossesWith "every Spinacia oleracea" ; perma:isolationM 1000.0 ; perma:seedViabilityYears 3 ; perma:selfSows false ;
        rdfs:comment "Male and female plants: keep enough plants (20 or more) for good seed."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] ] .

id:crop-swiss-chard a perma:Crop ;
    rdfs:label "Swiss chard"@en , "Mangold"@de , "Blette (poirée)"@fr , "Beta vulgaris"@la ;
    rdfs:comment "Leaf beet; picked leaf by leaf from early summer to the frosts."@en ;
    dwc:scientificName "Beta vulgaris" ;
    perma:sowingDepthMm 20 ; perma:seedsPerPoint 1 ; perma:germinationDays 10 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 8.0 ; perma:frostTender false ; perma:daysToHarvest 60 ; perma:spacingCm 30 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Biennial ; perma:pollination perma:WindPollinated ;
        perma:crossesWith "every Beta vulgaris: beetroot, sugar beet, other chards" ; perma:isolationM 1000.0 ; perma:seedViabilityYears 5 ; perma:selfSows false ;
        rdfs:comment "Overwinters and flowers in its second year; beet pollen travels far."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] ] .

id:crop-spring-onion a perma:Crop ;
    rdfs:label "Spring onion"@en , "Frühlingszwiebel"@de , "Ciboule"@fr , "Allium fistulosum"@la ;
    rdfs:comment "Welsh onion: green leaves and white stems, without a bulb."@en ;
    dwc:scientificName "Allium fistulosum" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 3 ; perma:germinationDays 12 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 7.0 ; perma:frostTender false ; perma:daysToHarvest 70 ; perma:spacingCm 5 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Perennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Allium fistulosum" ; perma:isolationM 800.0 ; perma:seedViabilityYears 2 ; perma:selfSows false ;
        rdfs:comment "Flowers from the second year; seed is short-lived."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] ] .

id:crop-chives a perma:Crop ;
    rdfs:label "Chives"@en , "Schnittlauch"@de , "Ciboulette"@fr , "Allium schoenoprasum"@la ;
    rdfs:comment "Perennial clumps; cut again and again, divide every few years."@en ;
    dwc:scientificName "Allium schoenoprasum" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 4 ; perma:germinationDays 14 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 10.0 ; perma:frostTender false ; perma:daysToHarvest 90 ; perma:spacingCm 20 ;
    perma:seedSaving [ perma:propagation perma:ByDivision ; perma:lifeCycle perma:Perennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other chives" ; perma:seedViabilityYears 2 ; perma:selfSows true ;
        rdfs:comment "Easiest kept by dividing clumps in spring; flowers are edible."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] , [ perma:method perma:Dried ; perma:storageMonths 6 ] ] .

id:crop-parsley a perma:Crop ;
    rdfs:label "Parsley"@en , "Petersilie"@de , "Persil"@fr , "Petroselinum crispum"@la ;
    rdfs:comment "Slow to germinate; overwinters and bolts in its second spring."@en ;
    dwc:scientificName "Petroselinum crispum" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 3 ; perma:germinationDays 21 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 8.0 ; perma:frostTender false ; perma:daysToHarvest 75 ; perma:spacingCm 15 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Biennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Petroselinum crispum, including root parsley" ; perma:isolationM 300.0 ; perma:seedViabilityYears 3 ; perma:selfSows true ;
        rdfs:comment "Flowers in its second summer."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] , [ perma:method perma:Dried ; perma:storageMonths 6 ] ] .

# ------------------------------------------------------------ fruit trees (v0.2)

id:crop-pear a perma:Crop ;
    rdfs:label "Pear"@en , "Birne"@de , "Poirier (poire)"@fr , "Pyrus communis"@la ;
    rdfs:comment "Most pears need a pollinator variety nearby; summer pears are picked just before ripe."@en ;
    dwc:scientificName "Pyrus communis" ;
    perma:growthForm perma:Tree ;
    perma:typicalWindow [ perma:activity perma:Flowering ; perma:fromMonth 4 ; perma:toMonth 4 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:Harvest ; perma:part perma:Fruit ; perma:fromMonth 8 ; perma:toMonth 10 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:WinterPrune ; perma:fromMonth 12 ; perma:toMonth 2 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:SummerPrune ; perma:fromMonth 7 ; perma:toMonth 8 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ;
    perma:seedSaving [ perma:propagation perma:ByGrafting ; perma:lifeCycle perma:Perennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other pear varieties (most pears need a pollinator)" ; perma:selfSows false ;
        rdfs:comment "Pears do not come true from seed: graft scions onto pear or quince rootstock in late winter."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 3 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-plum a perma:Crop ;
    rdfs:label "Plum"@en , "Pflaume"@de , "Prunier (prune)"@fr , "Prunus domestica"@la ;
    rdfs:comment "Includes greengages and mirabelles; pruned in summer only (silver leaf)."@en ;
    dwc:scientificName "Prunus domestica" ;
    perma:growthForm perma:Tree ;
    perma:typicalWindow [ perma:activity perma:Flowering ; perma:fromMonth 3 ; perma:toMonth 4 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:Harvest ; perma:part perma:Fruit ; perma:fromMonth 8 ; perma:toMonth 9 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:SummerPrune ; perma:fromMonth 6 ; perma:toMonth 7 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ;
    perma:seedSaving [ perma:propagation perma:ByGrafting ; perma:lifeCycle perma:Perennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other plums and gages; many varieties are self-fertile" ; perma:selfSows false ;
        rdfs:comment "Graft onto St Julien or Myrobalan in spring; suckers of own-root trees also come true."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 10 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-sweet-cherry a perma:Crop ;
    rdfs:label "Sweet cherry"@en , "Süßkirsche"@de , "Cerisier (cerise douce)"@fr , "Prunus avium"@la ;
    rdfs:comment "Most varieties need a pollinator; birds share the harvest unless netted."@en ;
    dwc:scientificName "Prunus avium" ;
    perma:growthForm perma:Tree ;
    perma:typicalWindow [ perma:activity perma:Flowering ; perma:fromMonth 4 ; perma:toMonth 4 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:Harvest ; perma:part perma:Fruit ; perma:fromMonth 6 ; perma:toMonth 7 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:SummerPrune ; perma:fromMonth 7 ; perma:toMonth 8 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ;
    perma:seedSaving [ perma:propagation perma:ByGrafting ; perma:lifeCycle perma:Perennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other sweet cherries (most need a compatible pollinator)" ; perma:selfSows false ;
        rdfs:comment "Graft onto Colt or Gisela; pruned in summer after the harvest."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 10 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Macerated ; perma:storageMonths 24 ] ] .

id:crop-sour-cherry a perma:Crop ;
    rdfs:label "Sour cherry"@en , "Sauerkirsche"@de , "Cerisier acide (griotte)"@fr , "Prunus cerasus"@la ;
    rdfs:comment "Morello type; self-fertile, fruits on last year's wood, tolerates a north wall."@en ;
    dwc:scientificName "Prunus cerasus" ;
    perma:growthForm perma:Tree ;
    perma:typicalWindow [ perma:activity perma:Flowering ; perma:fromMonth 4 ; perma:toMonth 5 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:Harvest ; perma:part perma:Fruit ; perma:fromMonth 7 ; perma:toMonth 8 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ,
        [ perma:activity perma:SummerPrune ; perma:fromMonth 8 ; perma:toMonth 8 ; perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland (north-west Europe), approximate" ] ;
    perma:seedSaving [ perma:propagation perma:ByGrafting ; perma:lifeCycle perma:Perennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other sour and sweet cherries" ; perma:selfSows false ;
        rdfs:comment "Self-fertile; graft onto Colt or Gisela, or keep own-root suckers."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 10 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Macerated ; perma:storageMonths 24 ] ] .

# Added 2026-10-10: crops of the carrot burger, a legume and a companion flower for mixed planting.

id:crop-carrot a perma:Crop ;
    rdfs:label "Carrot"@en , "Möhre"@de , "Carotte"@fr , "Daucus carota"@la ;
    rdfs:comment "Sown in place, never transplanted; slow to come up."@en ;
    dwc:scientificName "Daucus carota" ;
    perma:sowingDepthMm 10 ; perma:seedsPerPoint 3 ; perma:germinationDays 14 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 7.0 ; perma:frostTender false ; perma:daysToHarvest 75 ; perma:spacingCm 5 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Biennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Daucus carota, wild carrot included" ; perma:isolationM 800.0 ; perma:seedViabilityYears 3 ; perma:selfSows false ;
        rdfs:comment "Keep the best roots over winter and replant them; seed ripens in the second summer."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Root ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 5 ] ] .

id:crop-cucumber a perma:Crop ;
    rdfs:label "Cucumber"@en , "Gurke"@de , "Concombre"@fr , "Cucumis sativus"@la ;
    rdfs:comment "Gherkins (cornichons) are the same species, picked small. Trails, or climbs a net."@en ;
    dwc:scientificName "Cucumis sativus" ;
    perma:sowingDepthMm 20 ; perma:seedsPerPoint 2 ; perma:germinationDays 7 ; perma:waterMmPerWeek 35.0 ;
    perma:sowMinTempC 15.0 ; perma:plantOutMinNightC 10.0 ; perma:frostTender true ; perma:daysToHarvest 60 ; perma:spacingCm 40 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Cucumis sativus" ; perma:isolationM 400.0 ; perma:seedViabilityYears 6 ; perma:selfSows false ;
        rdfs:comment "Leave a fruit to ripen yellow on the plant; ferment the seed pulp a few days, wash, dry."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Pickled ; perma:storageMonths 12 ] ] .

id:crop-bush-bean a perma:Crop ;
    rdfs:label "Bush bean"@en , "Buschbohne"@de , "Haricot nain"@fr , "Phaseolus vulgaris"@la ;
    rdfs:comment "A legume: bacteria on its roots bring nitrogen into the soil. Cut it off at the base when it is done and leave the roots in."@en ;
    dwc:scientificName "Phaseolus vulgaris" ;
    perma:sowingDepthMm 30 ; perma:seedsPerPoint 2 ; perma:germinationDays 8 ; perma:waterMmPerWeek 25.0 ;
    perma:sowMinTempC 12.0 ; perma:plantOutMinNightC 8.0 ; perma:frostTender true ; perma:daysToHarvest 60 ; perma:spacingCm 15 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:SelfPollinating ;
        perma:crossesWith "other Phaseolus vulgaris, rarely" ; perma:isolationM 5.0 ; perma:seedViabilityYears 3 ; perma:selfSows false ;
        rdfs:comment "Let some pods dry on the plant; shell and dry the beans well."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 10 ] ] .

id:crop-marigold a perma:Crop ;
    rdfs:label "French marigold"@en , "Studentenblume"@de , "Œillet d'Inde"@fr , "Tagetes patula"@la ;
    rdfs:comment "A companion flower, grown for what it does for its neighbours; the petals are edible. GBIF's backbone treats Tagetes patula as a synonym of Tagetes erecta, so the taxon link is to that name."@en ;
    dwc:scientificName "Tagetes erecta" ;
    perma:sowingDepthMm 5 ; perma:seedsPerPoint 2 ; perma:germinationDays 7 ; perma:waterMmPerWeek 20.0 ;
    perma:sowMinTempC 12.0 ; perma:plantOutMinNightC 8.0 ; perma:frostTender true ; perma:daysToHarvest 60 ; perma:spacingCm 20 ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Tagetes patula" ; perma:isolationM 200.0 ; perma:seedViabilityYears 3 ; perma:selfSows false ;
        rdfs:comment "Dry the spent flower heads; the seeds are the black slivers inside."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Flower ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

# ------------------------------------------------------------ what each crop takes from the bed and gives to it
#
# For planting mixed (tbox/perma-food.ttl; packages/core/src/planting.ts places the plants from these).
# Traditional companion-planting guidance: evidence for single pairings is mixed, and all of it is to
# confirm on the bed itself. Neighbours are stated once and hold both ways. Trees are not in this list.
id:crop-courgette dwc:family "Cucurbitaceae" ; perma:feeding perma:HeavyFeeder ; perma:rootDepth perma:MediumRoot ; perma:heightCm 60 ;
    perma:gives perma:CoversSoil ;
    perma:goodNeighbour id:crop-bush-bean , id:crop-marigold , id:crop-onion .
id:crop-onion dwc:family "Amaryllidaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:ShallowRoot ; perma:heightCm 40 ;
    perma:gives perma:ConfusesPests ;
    perma:goodNeighbour id:crop-carrot , id:crop-lettuce , id:crop-tomato , id:crop-swiss-chard , id:crop-sweet-pepper , id:crop-white-cabbage ;
    perma:badNeighbour id:crop-bush-bean .
id:crop-sweet-pepper dwc:family "Solanaceae" ; perma:feeding perma:HeavyFeeder ; perma:rootDepth perma:MediumRoot ; perma:heightCm 70 ;
    perma:goodNeighbour id:crop-basil , id:crop-carrot , id:crop-marigold .
id:crop-dill dwc:family "Apiaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:MediumRoot ; perma:heightCm 90 ;
    perma:gives perma:FeedsPollinators ;
    perma:goodNeighbour id:crop-white-cabbage , id:crop-cucumber , id:crop-lettuce ;
    perma:badNeighbour id:crop-carrot , id:crop-caraway .
id:crop-white-mustard dwc:family "Brassicaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:DeepRoot ; perma:heightCm 60 ;
    perma:gives perma:CoversSoil , perma:LoosensSoil .
id:crop-tomato dwc:family "Solanaceae" ; perma:feeding perma:HeavyFeeder ; perma:rootDepth perma:DeepRoot ; perma:heightCm 150 ;
    perma:goodNeighbour id:crop-basil , id:crop-carrot , id:crop-garlic , id:crop-parsley , id:crop-chives , id:crop-marigold , id:crop-lettuce ;
    perma:badNeighbour id:crop-white-cabbage .
id:crop-aubergine dwc:family "Solanaceae" ; perma:feeding perma:HeavyFeeder ; perma:rootDepth perma:MediumRoot ; perma:heightCm 80 ;
    perma:goodNeighbour id:crop-bush-bean , id:crop-basil , id:crop-thyme .
id:crop-garlic dwc:family "Amaryllidaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:ShallowRoot ; perma:heightCm 50 ;
    perma:gives perma:ConfusesPests ;
    perma:goodNeighbour id:crop-carrot , id:crop-lettuce , id:crop-swiss-chard ;
    perma:badNeighbour id:crop-bush-bean .
id:crop-basil dwc:family "Lamiaceae" ; perma:feeding perma:MediumFeeder ; perma:rootDepth perma:ShallowRoot ; perma:heightCm 40 ;
    perma:gives perma:ConfusesPests , perma:FeedsPollinators .
id:crop-thyme dwc:family "Lamiaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:ShallowRoot ; perma:heightCm 25 ;
    perma:gives perma:ConfusesPests , perma:FeedsPollinators , perma:CoversSoil ;
    perma:goodNeighbour id:crop-white-cabbage , id:crop-tomato .
id:crop-rosemary dwc:family "Lamiaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:DeepRoot ; perma:heightCm 100 ;
    perma:gives perma:ConfusesPests , perma:FeedsPollinators ;
    perma:goodNeighbour id:crop-carrot , id:crop-white-cabbage , id:crop-bush-bean .
id:crop-white-cabbage dwc:family "Brassicaceae" ; perma:feeding perma:HeavyFeeder ; perma:rootDepth perma:MediumRoot ; perma:heightCm 40 ;
    perma:goodNeighbour id:crop-swiss-chard , id:crop-marigold , id:crop-spinach .
id:crop-caraway dwc:family "Apiaceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:DeepRoot ; perma:heightCm 60 ;
    perma:gives perma:LoosensSoil , perma:FeedsPollinators .
id:crop-lettuce dwc:family "Asteraceae" ; perma:feeding perma:LightFeeder ; perma:rootDepth perma:ShallowRoot ; perma:heightCm 25 ;
    perma:goodNeighbour id:crop-carrot , id:crop-radish , id:crop-chives , id:crop-spring-onion , id:crop-cucumber , id:crop-bush-bean , id:crop-rocket , id:crop-spinach ;
